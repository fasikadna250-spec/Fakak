          package com.faxtra.smoke

          import android.content.Context
          import android.graphics.Canvas
          import android.graphics.Color
          import android.graphics.Paint
          import android.graphics.RadialGradient
          import android.graphics.RectF
          import android.graphics.Shader
          import android.os.SystemClock
          import android.view.View
          import kotlin.math.cos
          import kotlin.math.min
          import kotlin.math.sin

          /** Animated holographic rings. Spins fast and pulses while SMOKE is listening. */
          class HudView(context: Context) : View(context) {

              var active = false
              var accent = Style.accent
              var accent2 = Style.accent2
              /** false = leave the middle empty for the logo. */
              var showCore = true

              private val stroke = Paint(Paint.ANTI_ALIAS_FLAG).apply {
                  style = Paint.Style.STROKE
                  strokeCap = Paint.Cap.ROUND
              }
              private val fill = Paint(Paint.ANTI_ALIAS_FLAG)
              private val oval = RectF()
              private val startTime = SystemClock.uptimeMillis()
              private var spin = 0f
              private var lastFrame = SystemClock.uptimeMillis()

              override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
                  val size = MeasureSpec.getSize(widthMeasureSpec)
                  setMeasuredDimension(size, size)
              }

              private fun arcs(c: Canvas, cx: Float, cy: Float, radius: Float, width: Float, rotation: Float,
                               segments: List<Pair<Float, Float>>, alpha: Int) {
                  stroke.color = accent
                  stroke.alpha = alpha
                  stroke.strokeWidth = width
                  oval.set(cx - radius, cy - radius, cx + radius, cy + radius)
                  for ((startAngle, sweep) in segments) {
                      c.drawArc(oval, startAngle + rotation, sweep, false, stroke)
                  }
              }

              override fun onDraw(c: Canvas) {
                  val now = SystemClock.uptimeMillis()
                  val dt = (now - lastFrame) / 1000f
                  lastFrame = now
                  spin += dt * (if (active) 1f else 0.2f)
                  val t = (now - startTime) / 1000f

                  val cx = width / 2f
                  val cy = height / 2f
                  val r = min(cx, cy) * 0.92f

                  // Outer tick ring
                  stroke.color = accent
                  stroke.strokeWidth = r * 0.008f
                  for (i in 0 until 72) {
                      val a = Math.toRadians((i * 5.0) + spin * 6.0)
                      val inner = r * (if (i % 6 == 0) 0.90f else 0.94f)
                      stroke.alpha = if (i % 6 == 0) 200 else 90
                      c.drawLine(
                          cx + (cos(a) * inner).toFloat(), cy + (sin(a) * inner).toFloat(),
                          cx + (cos(a) * r).toFloat(), cy + (sin(a) * r).toFloat(), stroke
                      )
                  }

                  arcs(c, cx, cy, r * 0.82f, r * 0.035f, spin * 40f,
                      listOf(0f to 70f, 110f to 35f, 170f to 120f, 310f to 25f), 230)
                  val keep = accent
                  accent = accent2
                  arcs(c, cx, cy, r * 0.75f, r * 0.012f, -spin * 65f,
                      listOf(20f to 140f, 200f to 90f, 300f to 30f), 190)
                  accent = keep

                  if (!showCore) {
                      // Pulsing ember halo hugging the logo
                      val glowAlpha = if (active) (120 + 100 * sin(t * 5f)).toInt().coerceIn(20, 230) else 70
                      stroke.color = accent
                      stroke.alpha = glowAlpha
                      stroke.strokeWidth = r * 0.02f
                      c.drawCircle(cx, cy, r * 0.69f, stroke)
                      postInvalidateOnAnimation()
                      return
                  }

                  arcs(c, cx, cy, r * 0.58f, r * 0.06f, spin * 25f,
                      (0 until 8).map { (it * 45f) to 30f }, 120)
                  arcs(c, cx, cy, r * 0.47f, r * 0.012f, -spin * 90f,
                      listOf(0f to 300f), 200)

                  // Glowing core
                  val pulse = if (active) 0.88f + 0.12f * sin(t * 5f) else 0.82f
                  val coreR = r * 0.40f * pulse
                  fill.shader = RadialGradient(
                      cx, cy, coreR,
                      intArrayOf(Color.argb(255, 210, 252, 255), Color.argb(170, Color.red(accent), Color.green(accent), Color.blue(accent)), Color.argb(0, 0, 0, 0)),
                      floatArrayOf(0f, 0.38f, 1f),
                      Shader.TileMode.CLAMP
                  )
                  c.drawCircle(cx, cy, coreR, fill)
                  stroke.alpha = 255
                  stroke.strokeWidth = r * 0.014f
                  c.drawCircle(cx, cy, r * 0.30f, stroke)

                  postInvalidateOnAnimation()
              }
          }
