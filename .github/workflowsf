          package com.faxtra.smoke

          import android.app.Notification
          import android.app.NotificationChannel
          import android.app.NotificationManager
          import android.app.PendingIntent
          import android.app.Service
          import android.content.Intent
          import android.content.pm.ServiceInfo
          import android.os.Build
          import android.os.Bundle
          import android.os.Handler
          import android.os.IBinder
          import android.os.Looper
          import android.os.SystemClock
          import android.speech.RecognitionListener
          import android.speech.RecognizerIntent
          import android.speech.SpeechRecognizer
          import android.speech.tts.TextToSpeech
          import java.util.Locale

          /** Keeps listening for "Hey Smoke, open ..." while SMOKE is switched on. */
          class SmokeService : Service(), RecognitionListener {

              companion object {
                  const val ACTION_STOP = "com.faxtra.smoke.STOP"
                  private const val CHANNEL_ID = "smoke_listening"
                  private const val NOTIFICATION_ID = 7
                  private const val FOLLOW_UP_WINDOW_MS = 8000L
                  @Volatile var isRunning = false
                  @Volatile var lastHeard = ""
                  @Volatile var lastReply = ""
              }

              private val handler = Handler(Looper.getMainLooper())
              private var recognizer: SpeechRecognizer? = null
              private var tts: TextToSpeech? = null
              private var ttsReady = false
              private var listening = false
              private var awaitingCommandUntil = 0L

              override fun onBind(intent: Intent?): IBinder? = null

              override fun onCreate() {
                  super.onCreate()
                  tts = TextToSpeech(this) { status ->
                      ttsReady = status == TextToSpeech.SUCCESS
                      if (ttsReady) {
                          val british = tts?.isLanguageAvailable(Locale.UK) ?: TextToSpeech.LANG_NOT_SUPPORTED
                          tts?.language = if (british >= TextToSpeech.LANG_AVAILABLE) Locale.UK else Locale.US
                          tts?.setPitch(0.85f)
                          tts?.setSpeechRate(1.0f)
                          if (isRunning) speak("SMOKE online. Ready when you are, boss.")
                      }
                  }
              }

              override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
                  if (intent?.action == ACTION_STOP) {
                      shutDown()
                      return START_NOT_STICKY
                  }
                  goForeground()
                  if (!isRunning) {
                      isRunning = true
                      startListening()
                  }
                  return START_STICKY
              }

              private fun goForeground() {
                  val nm = getSystemService(NotificationManager::class.java)
                  nm.createNotificationChannel(
                      NotificationChannel(CHANNEL_ID, "SMOKE listening", NotificationManager.IMPORTANCE_LOW)
                  )
                  val stopIntent = PendingIntent.getService(
                      this, 1,
                      Intent(this, SmokeService::class.java).setAction(ACTION_STOP),
                      PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT
                  )
                  val openIntent = PendingIntent.getActivity(
                      this, 2,
                      Intent(this, MainActivity::class.java),
                      PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT
                  )
                  @Suppress("DEPRECATION")
                  val notification = Notification.Builder(this, CHANNEL_ID)
                      .setSmallIcon(android.R.drawable.ic_btn_speak_now)
                      .setContentTitle("SMOKE is listening")
                      .setContentText("Say \"Hey Smoke, open WhatsApp\"")
                      .setOngoing(true)
                      .setContentIntent(openIntent)
                      .addAction(android.R.drawable.ic_menu_close_clear_cancel, "Stop", stopIntent)
                      .build()

                  if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
                      startForeground(NOTIFICATION_ID, notification, ServiceInfo.FOREGROUND_SERVICE_TYPE_MICROPHONE)
                  } else {
                      startForeground(NOTIFICATION_ID, notification)
                  }
              }

              private fun startListening() {
                  if (!isRunning) return
                  try {
                      recognizer?.destroy()
                      recognizer = SpeechRecognizer.createSpeechRecognizer(this).also {
                          it.setRecognitionListener(this)
                      }
                      val intent = Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH).apply {
                          putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM)
                          putExtra(RecognizerIntent.EXTRA_LANGUAGE, Locale.US.toLanguageTag())
                          putExtra(RecognizerIntent.EXTRA_MAX_RESULTS, 5)
                          putExtra(RecognizerIntent.EXTRA_PARTIAL_RESULTS, false)
                          putExtra(RecognizerIntent.EXTRA_CALLING_PACKAGE, packageName)
                      }
                      listening = true
                      recognizer?.startListening(intent)
                  } catch (e: Exception) {
                      listening = false
                      restartLater(2000)
                  }
              }

              private fun restartLater(delayMs: Long) {
                  handler.removeCallbacksAndMessages(null)
                  handler.postDelayed({ startListening() }, delayMs)
              }

              private fun handle(heardOptions: List<String>) {
                  val followUp = SystemClock.elapsedRealtime() < awaitingCommandUntil
                  for (heard in heardOptions) {
                      when (val result = CommandParser.parse(heard, requireWake = !followUp)) {
                          is CommandParser.Result.Open -> {
                              lastHeard = heard
                              awaitingCommandUntil = 0L
                              openApp(result.appName)
                              return
                          }
                          is CommandParser.Result.Time -> {
                              lastHeard = heard
                              awaitingCommandUntil = 0L
                              val now = java.text.SimpleDateFormat("h:mm a", Locale.US).format(java.util.Date())
                              speak("It's $now, boss.")
                              restartLater(2000)
                              return
                          }
                          is CommandParser.Result.WakeOnly -> {
                              lastHeard = heard
                              awaitingCommandUntil = SystemClock.elapsedRealtime() + FOLLOW_UP_WINDOW_MS
                              speak("Yes, boss?")
                              restartLater(1100)
                              return
                          }
                          CommandParser.Result.None -> Unit
                      }
                  }
                  restartLater(250)
              }

              private fun openApp(spokenName: String) {
                  val match = CommandParser.findApp(this, spokenName)
                  if (match == null) {
                      speak("Sorry boss, I can't find $spokenName.")
                      restartLater(2000)
                      return
                  }
                  val (pkg, label) = match
                  val launch = packageManager.getLaunchIntentForPackage(pkg)
                  if (launch == null) {
                      speak("I can't open $label")
                      restartLater(2000)
                      return
                  }
                  launch.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_RESET_TASK_IF_NEEDED)
                  try {
                      startActivity(launch)
                      speak("Opening $label.")
                  } catch (e: Exception) {
                      speak("Android blocked opening $label. Check display over other apps.")
                  }
                  restartLater(2000)
              }

              private fun speak(text: String) {
                  lastReply = text
                  if (ttsReady) tts?.speak(text, TextToSpeech.QUEUE_FLUSH, null, "smoke")
              }

              private fun shutDown() {
                  isRunning = false
                  lastReply = "Shutting down."
                  listening = false
                  handler.removeCallbacksAndMessages(null)
                  recognizer?.destroy()
                  recognizer = null
                  stopForeground(STOP_FOREGROUND_REMOVE)
                  stopSelf()
              }

              override fun onDestroy() {
                  isRunning = false
                  handler.removeCallbacksAndMessages(null)
                  recognizer?.destroy()
                  recognizer = null
                  tts?.shutdown()
                  tts = null
                  super.onDestroy()
              }

              // --- RecognitionListener ---
              override fun onResults(results: Bundle?) {
                  listening = false
                  val heard = results?.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION).orEmpty()
                  if (heard.isEmpty()) restartLater(250) else handle(heard)
              }

              override fun onError(error: Int) {
                  listening = false
                  val delay = when (error) {
                      SpeechRecognizer.ERROR_RECOGNIZER_BUSY -> 1500L
                      SpeechRecognizer.ERROR_INSUFFICIENT_PERMISSIONS -> 10000L
                      SpeechRecognizer.ERROR_NETWORK, SpeechRecognizer.ERROR_NETWORK_TIMEOUT, SpeechRecognizer.ERROR_SERVER -> 3000L
                      else -> 300L
                  }
                  restartLater(delay)
              }

              override fun onReadyForSpeech(params: Bundle?) = Unit
              override fun onBeginningOfSpeech() = Unit
              override fun onRmsChanged(rmsdB: Float) = Unit
              override fun onBufferReceived(buffer: ByteArray?) = Unit
              override fun onEndOfSpeech() = Unit
              override fun onPartialResults(partialResults: Bundle?) = Unit
              override fun onEvent(eventType: Int, params: Bundle?) = Unit
          }
