              // ---------- Helpers ----------

              private fun dp(v: Int) = (v * density).toInt()

              private fun mono(text: String, size: Float, color: Int, bold: Boolean = false) = TextView(this).apply {
                  this.text = text
                  textSize = size
                  setTextColor(color)
                  typeface = Typeface.create(Typeface.MONOSPACE, if (bold) Typeface.BOLD else Typeface.NORMAL)
