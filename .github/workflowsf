              private fun column(vararg views: View) = LinearLayout(this).apply {
                  orientation = LinearLayout.VERTICAL
                  gravity = Gravity.CENTER_HORIZONTAL
                  views.forEach { addView(it) }
              }

              private fun tick() {
                  val now = Date()
                  val localZone = TimeZone.getDefault()
                  val addis = TimeZone.getTimeZone("Africa/Addis_Ababa")
                  val timeFmt = SimpleDateFormat("h:mm a", Locale.US)
                  val dateFmt = SimpleDateFormat("EEE dd MMM", Locale.US)

                  timeFmt.timeZone = localZone
                  dateFmt.timeZone = localZone
                  localTime.text = timeFmt.format(now)
                  localDate.text = dateFmt.format(now)
                  localLabel.text = localZone.id.substringAfterLast('/').replace('_', ' ').uppercase(Locale.US)

                  timeFmt.timeZone = addis
                  dateFmt.timeZone = addis
                  homeTime.text = timeFmt.format(now)
                  val diff = (addis.getOffset(now.time) - localZone.getOffset(now.time)) / 3_600_000f
                  val diffText = if (diff % 1f == 0f) String.format(Locale.US, "%+dH", diff.toInt())
                  else String.format(Locale.US, "%+.1fH", diff)
                  homeDate.text = dateFmt.format(now) + "  " + diffText

                  val on = SmokeService.isRunning
                  hud.active = on
              }

              private fun toggleListening() {
                  when {
                      SmokeService.isRunning ->
                          startService(Intent(this, SmokeService::class.java).setAction(SmokeService.ACTION_STOP))
                      checkSelfPermission(Manifest.permission.RECORD_AUDIO) == PackageManager.PERMISSION_GRANTED &&
                          Settings.canDrawOverlays(this) ->
                          startForegroundService(Intent(this, SmokeService::class.java))
                      else -> startActivity(Intent(this, MainActivity::class.java))
                  }
                  ui.postDelayed({ tick() }, 300)
              }

              private fun loadApps() {
                  Thread {
                      val pm = packageManager
                      val launcher = Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_LAUNCHER)
                      val list = pm.queryIntentActivities(launcher, 0)
                          .map { AppEntry(it.loadLabel(pm).toString(), it.activityInfo.packageName, it.loadIcon(pm)) }
                          .distinctBy { it.pkg }
                          .sortedBy { it.label.lowercase(Locale.US) }
                      ui.post {
                          apps = list
                          buildGrid(search.text?.toString().orEmpty())
                      }
                  }.start()
              }

              private fun buildGrid(filter: String) {
                  grid.removeAllViews()
                  val q = filter.trim()
                  val list = if (q.isEmpty()) apps else apps.filter { it.label.contains(q, ignoreCase = true) }
                  var row: LinearLayout? = null
                  list.forEachIndexed { i, app ->
                      if (i % 4 == 0) {
                          val newRow = LinearLayout(this).apply { orientation = LinearLayout.HORIZONTAL }
                          grid.addView(newRow)
                          row = newRow
                      }
                      row?.addView(appCell(app, 54, showLabel = true), LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f))
                  }
                  val rest = list.size % 4
                  if (rest != 0) repeat(4 - rest) {
                      row?.addView(View(this), LinearLayout.LayoutParams(0, 1, 1f))
                  }
                  if (list.isEmpty()) grid.addView(mono("NO MATCH", 13f, Style.dim).apply { setPadding(0, dp(24), 0, 0) })
              }

              private fun appCell(app: AppEntry, sizeDp: Int, showLabel: Boolean): LinearLayout {
                  val cell = LinearLayout(this).apply {
                      orientation = LinearLayout.VERTICAL
                      gravity = Gravity.CENTER_HORIZONTAL
                      setPadding(dp(4), dp(8), dp(4), dp(8))
                      isClickable = true
                      contentDescription = app.label
                      setOnClickListener { launch(app.pkg) }
                      setOnLongClickListener {
                          startActivity(Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS, Uri.parse("package:${app.pkg}")))
                          true
                      }
                  }
                  cell.addView(ImageView(this).apply {
                      setImageDrawable(app.icon)
                      val p = dp(9)
                      setPadding(p, p, p, p)
                      background = GradientDrawable().apply {
                          shape = GradientDrawable.OVAL
                          setColor(Style.glass(30))
                          setStroke(dp(1), Style.glass(170))
                      }
                  }, LinearLayout.LayoutParams(dp(sizeDp), dp(sizeDp)))
                  if (showLabel) {
                      cell.addView(mono(app.label, 11f, Style.text).apply {
                          maxLines = 1
                          ellipsize = TextUtils.TruncateAt.END
                          setPadding(0, dp(6), 0, 0)
                      })
                  }
                  return cell
              }

              private fun launch(pkg: String) {
                  packageManager.getLaunchIntentForPackage(pkg)?.let {
                      it.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
                      startActivity(it)
                  }
              }

              private fun openDrawer() {
                  search.setText("")
                  drawer.visibility = View.VISIBLE
              }

              private fun closeDrawer() {
                  if (drawer.visibility != View.VISIBLE) return
                  drawer.visibility = View.GONE
                  val imm = getSystemService(Context.INPUT_METHOD_SERVICE) as InputMethodManager
                  imm.hideSoftInputFromWindow(search.windowToken, 0)
              }
          }
