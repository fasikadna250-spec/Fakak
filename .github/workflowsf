          package com.faxtra.smoke

          import android.content.Context
          import android.content.Intent

          /** Understands "hey smoke, open whatsapp" and finds the app to launch. */
          object CommandParser {

              // Ways speech recognition may hear "Smoke".
              private val wakeWords = listOf("smoke", "smokey", "smoky", "smokie")

              sealed class Result {
                  object None : Result()
                  object WakeOnly : Result()
                  object Time : Result()
                  data class Open(val appName: String) : Result()
              }

              /**
               * @param requireWake if false (just after "Hey Smoke" alone), an "open X" without the wake word is accepted.
               */
              fun parse(heard: String, requireWake: Boolean): Result {
                  val text = heard.lowercase().replace(",", " ").replace(".", " ").trim()
                  val words = text.split(Regex("\\s+")).filter { it.isNotEmpty() }
                  val wakeIndex = words.indexOfFirst { it in wakeWords }

                  if (requireWake && wakeIndex < 0) return Result.None

                  val afterWake = if (wakeIndex >= 0) words.drop(wakeIndex + 1) else words
                  val openIndex = afterWake.indexOfFirst { it == "open" || it == "launch" || it == "start" }
                  if (openIndex >= 0) {
                      val name = afterWake.drop(openIndex + 1).joinToString(" ").trim()
                      if (name.isNotEmpty()) return Result.Open(name)
                  }
                  if (afterWake.contains("time") && (afterWake.contains("what") || afterWake.contains("what's"))) {
                      return Result.Time
                  }
                  return if (wakeIndex >= 0) Result.WakeOnly else Result.None
              }

              private fun normalize(s: String): String =
                  s.lowercase().filter { it.isLetterOrDigit() }

              /** Returns the package name of the best matching installed app, or null. */
              fun findApp(context: Context, spokenName: String): Pair<String, String>? {
                  val wanted = normalize(spokenName)
                  if (wanted.isEmpty()) return null

                  val pm = context.packageManager
                  val launcher = Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_LAUNCHER)
                  val apps = pm.queryIntentActivities(launcher, 0).map { info ->
                      val label = info.loadLabel(pm).toString()
                      Triple(normalize(label), label, info.activityInfo.packageName)
                  }

                  apps.firstOrNull { it.first == wanted }?.let { return it.third to it.second }
                  apps.filter { it.first.startsWith(wanted) }.minByOrNull { it.first.length }
                      ?.let { return it.third to it.second }
                  apps.filter { it.first.contains(wanted) }.minByOrNull { it.first.length }
                      ?.let { return it.third to it.second }
                  apps.filter { it.first.length >= 3 && wanted.contains(it.first) }.maxByOrNull { it.first.length }
                      ?.let { return it.third to it.second }
                  return null
              }
          }
